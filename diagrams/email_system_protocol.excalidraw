      "text": "Important boundaries\nTOFU first contact is unauthenticated; needs out-of-band verification or trusted provisioning • no transcript-bound Finished/key confirmation\nnonce/counter lifecycle needs explicit guarantees • prototype is not audited",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Important boundaries\nTOFU first contact is unauthenticated; needs out-of-band verification or trusted provisioning • no transcript-bound Finished/key confirmation\nnonce/counter lifecycle needs explicit guarantees • prototype is not audited",
      "autoResize": false,
      "lineHeight": 1.25
    },
