      "isDeleted": false,
      "boundElements": null,
      "updated": 1795460000000,
      "link": null,
      "locked": false,
      "text": "HMAC-SHA3-256 authenticates HEADER || counter.  AES-256-GCM authenticates ciphertext with counter as AAD.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "HMAC-SHA3-256 authenticates HEADER || counter.  AES-256-GCM authenticates ciphertext with counter as AAD.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "2af3e70b4cf94d51",
      "type": "text",
      "x": 58,
      "y": 1243,
      "width": 1640,
      "height": 22,
      "angle": 0,
      "strokeColor": "#344054",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.3,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "48",
      "roundness": null,
      "seed": 1564299578,
      "version": 1,
      "versionNonce": 1946753322,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795460000000,
      "link": null,
      "locked": false,
      "text": "Header length = ciphertext + 16-byte tag (excludes 12-byte nonce).  End marker = 00 00 00 || HMAC; it consumes a counter.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Header length = ciphertext + 16-byte tag (excludes 12-byte nonce).  End marker = 00 00 00 || HMAC; it consumes a counter.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "f40df0415d5d4889",
      "type": "text",
      "x": 58,
      "y": 1281,
      "width": 1640,
      "height": 22,
      "angle": 0,
      "strokeColor": "#667085",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.3,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "49",
      "roundness": null,
      "seed": 386932975,
      "version": 1,
      "versionNonce": 250147848,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795460000000,
      "link": null,
      "locked": false,
      "text": "Receiver: read header + HMAC → advance expected counter → verify HMAC → read nonce/body → GCM decrypt → append plaintext.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Receiver: read header + HMAC → advance expected counter → verify HMAC → read nonce/body → GCM decrypt → append plaintext.",
      "autoResize": false,
      "lineHeight": 1.25
    },
